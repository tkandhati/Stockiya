# ------------------------------------------------------------
# Stockiya backend environment
#
# setup.bat (and start.bat if backend/.env is missing) copies this file
# to backend/.env on first run. Edit backend/.env (NOT this file) once
# you already have one; git pulls will not touch backend/.env.
# ------------------------------------------------------------

# ---- DATA SOURCE ----
# RECOMMENDED: bhavcopy (India-native NSE end-of-day). A run is a turn-key
# download -> analyze -> erase cycle (backend/bhavcopy_fetch.py): it pulls only
# the daily NSE "securities bhavdata full" files the lookback needs (ONE file =
# the WHOLE market, incl. delivery %), pivots the scan universe into a tiny
# per-symbol cache, analyses, and erases the bulky raw dumps. ZERO per-ticker
# Yahoo calls = NO rate limiting. This is the fix for persistent Yahoo 429s.
#
#   DATA_SOURCE=bhavcopy   # (default) offline NSE EOD; no Yahoo, no 429s
#   DATA_SOURCE=yahoo      # legacy live yfinance (rate-limited; see below)
#
# On a network where NSE AND Yahoo are blocked, set `DEMO_MODE=1` below
# (synthetic data — UI verification only, NOT tradable).

DATA_SOURCE=bhavcopy

# ---- DEMO MODE ----
# 0 = real data via DATA_SOURCE above
# 1 = synthetic in-memory OHLCV. Overrides DATA_SOURCE. UI/dev only.
#     DO NOT trade on demo prices.
DEMO_MODE=0

# ---- YAHOO RATE LIMITING (only relevant when DATA_SOURCE=yahoo) ----
# Yahoo aggressively returns HTTP 429 ("Too Many Requests"). All yfinance
# access goes through backend/yf_session.py, which throttles, retries, caches
# to data/yf_cache, and freezes ALL workers on a 429. Diagnose any time with:
#   backend\.venv\Scripts\python.exe -m backend.yf_session RELIANCE.NS AAPL
#
# #1 FIX — browser impersonation (Yahoo blocks the default Python UA outright):
#   backend\.venv\Scripts\python.exe -m pip install curl_cffi
# yf_session auto-uses it; you'll see "browser impersonation ACTIVE" in the log.
#
# ONE Yahoo call per stock (the 2026-09-19 throttling fix):
#   * STOCKYA_YF_SKIP_INFO=1 (default) skips the per-ticker .info AND fast_info
#     calls entirely — every numeric field is derived from the OHLCV frame, and
#     company/sector labels degrade to None (sector comes from
#     config/sector_map.json). Set =0 to restore .info labels.
#   * STOCKYA_YF_RUN_MEMO=1 (default) fetches each symbol's history at most ONCE
#     per run — even a failed/empty fetch is remembered — so a rate-limited stock
#     no longer re-fires from snapshot(), history_ohlcv() and history_6m(). Set =0
#     to disable the per-run memo.
#   * STOCKYA_FETCH_LOOKBACK_DAYS=450 (default) — fetch only the REQUIRED interval
#     (~450 calendar days ≈ 310 trading bars) instead of a blanket 2y. Floored at
#     400 so the 200d MA / OBV-90d / ADV50 stay at full lookback. Raise toward 730
#     to restore ~2 years.
#   * STOCKYA_MAX_WORKERS — thread-pool width. Defaults to 2 for DATA_SOURCE=yahoo
#     (fewer concurrent dispatches = far fewer 429s; slower but complete) and 10
#     for bhavcopy/demo. Set e.g. 1 to be maximally gentle.
# STOCKYA_YF_SKIP_INFO=1
# STOCKYA_YF_RUN_MEMO=1
# STOCKYA_FETCH_LOOKBACK_DAYS=450
# STOCKYA_MAX_WORKERS=2
#
# Pacing knobs (defaults shown). With curl_cffi you can lower the interval; if
# you STILL see 429s, raise it (e.g. 4) — data prep gets slower but succeeds.
# STOCKYA_YF_MIN_INTERVAL=2.0
# STOCKYA_YF_MAX_RETRIES=5
# STOCKYA_YF_429_SLEEP=20
# STOCKYA_YF_IMPERSONATE=1
# STOCKYA_YF_CACHE=1
#
# DROPPED-STOCK RE-SWEEP (the "read ALL the stocks" fix, 2026-09-26). If Yahoo
# rate-limits a symbol into an empty frame during the main fan-out, it gets
# dropped at [I] Ingest. After the main pass the orchestrator re-fetches ONLY
# those dropped symbols — single-threaded, after a cooldown that lets Yahoo's
# per-IP window drain, with a wider dispatch interval — for up to N passes,
# stopping early if a pass recovers nothing. Successful symbols are never
# re-fetched. Watch the "[Phase 1.5] Re-sweep ... recovered X/Y" log lines.
# STOCKYA_YF_RESWEEP=1                 # 0 disables the re-sweep (old single-pass)
# STOCKYA_YF_RESWEEP_MAX_PASSES=2      # how many recovery passes to attempt
# STOCKYA_YF_RESWEEP_COOLDOWN=30       # seconds to wait before each pass
# STOCKYA_YF_RESWEEP_MIN_INTERVAL=4.0  # dispatch spacing DURING the sweep

# ---- SECTION 2: PULLBACK RE-ENTRY SETUPS (impulse -> VDU pullback -> breakout) ----
# The on-screen report is trimmed to two sections: Top picks by volume, and this
# setup evaluated on PREVIOUS picks that still show persisted interest. Interest
# is judged on accumulation-CONTINUITY, not raw volume size (a quiet low-volume
# dip is a bullish VDU supply test, not weakness).
# STOCKYA_PULLBACK_SETUPS=1            # 0 disables the whole section
# STOCKYA_HISTSETUP_LOOKBACK_DAYS=45   # how far back a previous pick may have been suggested
# STOCKYA_INTEREST_OBV_SLOPE_MIN=0     # min OBV-90d normalized slope % to count as "interest"
# STOCKYA_INTEREST_UD_RATIO_MIN=1.0    # min up/down-volume ratio (90d)
# STOCKYA_PULLBACK_SHOW_FADED=0        # 1 = also list names whose interest faded

# ---- MACRO CONTEXT (yfinance: US indices / USD-INR / Nifty; 4 symbols) ----
# Scoring-neutral context, cached ~18h. This is the ONLY yfinance dependency
# when DATA_SOURCE=bhavcopy. Set to 0 to disable it entirely (fully offline).
# STOCKYA_MACRO_CONTEXT=1

# ---- INDEPENDENT PRICE-TREND DISCOVERY UNIVERSE ----
# The volume strategy always scans the owner-supplied list in
# config/universe_custom.txt (~450 names; in-code NIFTY_300 fallback if empty);
# this setting only scopes the independent discovery scanners (e.g. Price Trend)
# and cannot change the volume picks.
# nifty50 (fast) / nifty100 / nifty200 / nifty300 / nifty500 (~456 tickers,
# curated) / niftytotal (default, ~754 = Nifty Total Market) /
# custom = read tickers from config/universe_custom.txt.
# NOTE: "nifty300" is a pragmatic top-300 slice of the curated 500 set, NOT an
# official index; "niftytotal" IS the official NSE Nifty Total Market membership.
STOCKYA_UNIVERSE=niftytotal

# ---- OFFLINE BHAVCOPY (DATA_SOURCE=bhavcopy) ----
# backend/bhavcopy_fetch.py maintains the per-symbol OHLCV cache automatically:
# each run downloads only the trading days MISSING since the last run (full
# backfill on a cold cache), pivots the scan universe out of each whole-market
# daily file, and ALWAYS erases the bulky raw NSE dumps afterwards. The tiny
# per-symbol CSVs (~10 MB) are kept as a rolling window so the next run only
# fetches the new day(s). Diagnose connectivity any time with:
#   backend\.venv\Scripts\python.exe -m backend.bhavcopy_fetch selftest
#
# STOCKYA_OHLCV_DIR            # per-symbol cache dir (default: <repo>/data/ohlcv)
# STOCKYA_BHAVCOPY_AUTO=1      # 0 = don't auto-download; manage the cache yourself
# STOCKYA_BHAVCOPY_LOOKBACK_DAYS=400  # calendar days of history to maintain (floor 320)
# STOCKYA_BHAVCOPY_WIPE=0      # 1 = also erase the per-symbol cache after each run
#                              #     (true zero-footprint; re-downloads full window every run)
# STOCKYA_BHAVCOPY_SLEEP=0.35  # polite seconds between daily-file downloads
# STOCKYA_BHAVCOPY_TIMEOUT=15  # per-request socket timeout (seconds)
# STOCKYA_BHAVCOPY_MAX_CONSEC_FAIL=4  # abort the run's downloads after N straight
#                              #     connection failures (NSE unreachable/blocked)
#
# The offline cycle also pulls everything else the VOLUME analysis uses and
# generates the daily delivery file from bhavcopy (no separate MTO download):
# STOCKYA_BHAVCOPY_FETCH_DEALS=1  # also download NSE bulk/block deals (block_deals.py)
# STOCKYA_BHAVCOPY_EMIT_MTO=1     # generate MTO_<date>.DAT so delivery.py works offline

# ---- ARCHIVE / RETENTION POLICY (backend/data_archive.py) ----
# One policy per data file, DOWNLOADED and GENERATED, enforced at the end of
# every run. See the full table: python -m backend.data_archive describe
#   bhavcopy_raw (raw dumps) ...... erased after each run (ephemeral)
#   deals_raw (bulk/block) ........ overwritten daily by NSE
#   ohlcv / delivery_sidecar ...... per-symbol rolling WINDOW (row-wise at write)
#   delivery_daily (MTO_*.DAT) .... keep N days          [STOCKYA_ARCHIVE_DELIVERY_DAILY_DAYS=45]
#   deals_all (all.csv) ........... rolling month (block_deals.prune_all_csv)
#   picks_<date>.json ............. KEEP; archived to data/archive/picks after N days
#                                   [STOCKYA_ARCHIVE_PICKS_DAYS=120]
# STOCKYA_ARCHIVE_PRUNE_ORPHANS=0  # 1 = also delete per-symbol CSVs no longer in the universe

# ---- POSITION SIZER ----
# Account size in INR for [PS] Position Sizer share-count math.
# STOCKYA_ACCOUNT_VALUE=100000

# ---- OPTIONAL ----
# Anthropic key is unused by the deterministic pipeline. Leave blank.
# ANTHROPIC_API_KEY=
